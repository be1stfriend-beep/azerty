# Copy this file to local.env and fill in the paths for this PC.
# local.env is gitignored. Real environment variables override these values.

# Godot 4.7.2 executable (required for tools/run_two.py, tools/check.py, tools/build_android.py)
GODOT_BIN=C:\Godot\Godot_v4.7.2-stable_win64.exe

# Android SDK folder (only for tools/build_android.py; optional if adb is on PATH)
ANDROID_HOME=
